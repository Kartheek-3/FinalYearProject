# SEAM Platform Configuration

# The system uses a provider-neutral abstraction. Configure your preferred local or remote LLM here.
# For Ollama, leave the API key as a harmless placeholder. For remote APIs, inject the real key dynamically.
SEAM_LLM_PROVIDER="openai_compatible"
SEAM_LLM_BASE_URL="http://localhost:11434/v1"
SEAM_LLM_API_KEY="ollama"

# Logical Agent Models (Maps SEAM agent roles to logical SupportedModel keys)
SEAM_ANALYSIS_MODEL="llama-3.1"
SEAM_PLANNING_MODEL="llama-3.1"
SEAM_CODING_MODEL="qwen2.5-coder"
SEAM_QA_MODEL="qwen2.5-coder"

# Physical Model Overrides (Maps logical SupportedModel keys to actual endpoint strings)
SEAM_LLAMA_3_1_MODEL="llama3.1:latest"
SEAM_DEEPSEEK_CODER_MODEL="deepseek-coder"
SEAM_QWEN2_5_CODER_MODEL="qwen2.5-coder"

# Docker Deployment Provider Configuration (Optional)
# SEAM_DOCKER_PORT_MIN=10000
# SEAM_DOCKER_PORT_MAX=20000
# SEAM_DOCKER_MEMORY_LIMIT="512m"
# SEAM_DOCKER_NANO_CPUS=1000000000
